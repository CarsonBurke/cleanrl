  "findings": [
    {
      "kind": "reference discrepancy",
      "finding": "Local output-row equalizer differs from nanoGPT shape-dependent long-axis equalizer on second gate/up weights (43x64).",
      "evidence": [
        "cleanrl/ppo_continuous_action_sepclip_normuon_split_diagnostic_v2.py:68",
        "../modded-nanogpt/train_gpt_medium.py:658",
        "../modded-nanogpt/track_1_short/optim/anvil.py:427"
      ],
      "interpretation": "A full-rank exact wide polar has equal row energies, so output-row adaptation is then redundant. Column energies are leverage scores. The paper itself uses output rows, so this is not an intrinsic NorMuon algorithm bug."
    },
    {
      "kind": "confirmed optimizer API bug",
      "finding": "Standard load_state_dict leaves cached stack state and parameter-group dictionaries stale.",
      "evidence": [
        "cleanrl/ppo_continuous_action_sepclip_normuon_split_diagnostic_v2.py:79",
        "scripts/diagnose_sepclip_normuon_history.py:21"
      ],
      "interpretation": "Does not explain fresh training; original real-history diagnostic already compensates by rebuilding stacks."
    },
    {
      "kind": "normalization convention",
      "finding": "Paper Algorithm 1 fixes update norm at 0.2*sqrt(out*in)*lr. Our casmi port preserves the approximate polar norm, then uses sqrt(max(1,out/in)).",
      "source": "https://arxiv.org/html/2510.05491v1#S3",
      "interpretation": "Different layerwise LR calibration; not evidence that either is universally wrong."
    },
    {
      "kind": "verified source equivalence",
      "finding": "Polar Express coefficients, bf16 casting, transpose handling, margin, epsilon, EMA, Nesterov and per-matrix norm restoration match casmi. Optimizer membership is disjoint and state is not shared across actor/critic matrices."
    },
    {
      "kind": "integration difference",
      "finding": "nGPT projects gate/up rows and down columns after every optimizer step. nanoGPT uses distinct weight layouts, role multipliers, momentum schedules and decay.",
      "interpretation": "Effective projected updates are not determined solely by the optimizer formula. Copying nanoGPT storage-shape LR multipliers without functional layout analysis would be unsound."
    }
  ],
